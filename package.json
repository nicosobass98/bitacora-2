{
  "name": "bitacora-2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Bitácora v2 — registro de jornadas, notas y búsqueda histórica bidireccional. PWA local-first.",
  "scripts": {
    "dev": "vite",
